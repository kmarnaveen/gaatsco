# Google Sheets Configuration
# Copy this file to .env.local and fill in your actual values

# Your Google Sheet ID (from the sheet URL)
GOOGLE_SHEET_ID=1CNRtng3LXFUlOi64cQPqvfrzz5P89lj911ZKOAJDv1U

# Service Account Email (from your Google Cloud Console)
# Example: contact-form-service@your-project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com

# Private Key (from the downloaded JSON credentials file)
# Keep the quotes and the \n characters as shown
# Copy the entire key including the BEGIN and END markers
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key content here\n-----END PRIVATE KEY-----\n"

# --- Search engine verification (optional) ---
# Google Search Console: Add property -> "HTML tag" method -> paste the token
# (the content="..." value only, not the whole tag). Then redeploy and click Verify.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools: same idea, the msvalidate.01 content value.
BING_SITE_VERIFICATION=
